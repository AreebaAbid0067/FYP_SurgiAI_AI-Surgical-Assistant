GROQ_API_KEY=your-groq-api-key
PINECONE_API_KEY=your-pinecone-api-key
# Admin account (seeded on first start). If unset, a one-time password is logged.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-strong-password
# Comma-separated allowed browser origins
# FRONTEND_ORIGINS=http://localhost:3000
# optional overrides
# PINECONE_INDEX_NAME=surgical-assistant
# SURGIAI_GUIDELINES_NS=surgiai-guidelines-v2
# SURGIAI_UCT_NS=uct-general-surgery-v2
# SURGIAI_MIN_SCORE=0.30
